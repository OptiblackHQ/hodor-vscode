{
  "name": "hodor",
  "displayName": "Hodor",
  "description": "Your product's tracking plan from Hodor, inside VS Code and Cursor: browse events, copy tracking code, and an AI coding agent that adds the events to your code.",
  "version": "0.5.0",
  "publisher": "optiblack",
  "license": "MIT",
  "author": "Optiblack <dev@optiblack.com>",
  "homepage": "https://hodor.optiblack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptiblackHQ/hodor-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "analytics",
    "tracking plan",
    "mixpanel",
    "posthog",
    "rudderstack"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:hodor.events",
    "onView:hodor.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hodor",
          "title": "Hodor",
          "icon": "media/hodor.svg"
        }
      ]
    },
    "views": {
      "hodor": [
        {
          "id": "hodor.events",
          "name": "Events"
        },
        {
          "type": "webview",
          "id": "hodor.chat",
          "name": "Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hodor.events",
        "contents": "Sign in to see your product's tracking plan.\n[Sign in to Hodor](command:hodor.signIn)",
        "when": "!hodor.signedIn"
      },
      {
        "view": "hodor.events",
        "contents": "Choose the product this code belongs to.\n[Pick a product](command:hodor.pickProject)",
        "when": "hodor.signedIn && !hodor.hasProject"
      }
    ],
    "commands": [
      {
        "command": "hodor.signIn",
        "title": "Sign in",
        "category": "Hodor"
      },
      {
        "command": "hodor.signOut",
        "title": "Sign out",
        "category": "Hodor"
      },
      {
        "command": "hodor.pickProject",
        "title": "Pick product",
        "category": "Hodor",
        "icon": "$(project)"
      },
      {
        "command": "hodor.refresh",
        "title": "Refresh",
        "category": "Hodor",
        "icon": "$(refresh)"
      },
      {
        "command": "hodor.search",
        "title": "Search events",
        "category": "Hodor",
        "icon": "$(search)"
      },
      {
        "command": "hodor.clearSearch",
        "title": "Clear search",
        "category": "Hodor",
        "icon": "$(clear-all)"
      },
      {
        "command": "hodor.openEvent",
        "title": "Open event",
        "category": "Hodor"
      },
      {
        "command": "hodor.setStatus",
        "title": "Set status",
        "category": "Hodor"
      },
      {
        "command": "hodor.copyCode",
        "title": "Copy code",
        "category": "Hodor"
      },
      {
        "command": "hodor.openInHodor",
        "title": "Open in Hodor",
        "category": "Hodor"
      },
      {
        "command": "hodor.newChat",
        "title": "New chat",
        "category": "Hodor",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hodor.search",
          "when": "view == hodor.events && hodor.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "hodor.clearSearch",
          "when": "view == hodor.events && hodor.searching",
          "group": "navigation@2"
        },
        {
          "command": "hodor.refresh",
          "when": "view == hodor.events && hodor.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "hodor.pickProject",
          "when": "view == hodor.events && hodor.signedIn",
          "group": "navigation@4"
        },
        {
          "command": "hodor.signOut",
          "when": "view == hodor.events && hodor.signedIn",
          "group": "zz"
        },
        {
          "command": "hodor.newChat",
          "when": "view == hodor.chat",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "hodor.setStatus",
          "when": "view == hodor.events && viewItem == event",
          "group": "1@1"
        },
        {
          "command": "hodor.copyCode",
          "when": "view == hodor.events && viewItem == event",
          "group": "1@2"
        },
        {
          "command": "hodor.openInHodor",
          "when": "view == hodor.events && viewItem == event",
          "group": "1@3"
        }
      ],
      "commandPalette": [
        {
          "command": "hodor.openEvent",
          "when": "false"
        },
        {
          "command": "hodor.setStatus",
          "when": "false"
        },
        {
          "command": "hodor.copyCode",
          "when": "false"
        },
        {
          "command": "hodor.openInHodor",
          "when": "false"
        },
        {
          "command": "hodor.signIn",
          "when": "!hodor.signedIn"
        },
        {
          "command": "hodor.signOut",
          "when": "hodor.signedIn"
        },
        {
          "command": "hodor.pickProject",
          "when": "hodor.signedIn"
        },
        {
          "command": "hodor.clearSearch",
          "when": "hodor.searching"
        }
      ]
    },
    "configuration": {
      "title": "Hodor",
      "properties": {
        "hodor.serverUrl": {
          "type": "string",
          "default": "https://hodor.optiblack.com",
          "description": "Hodor server address. Change it only to test against a local Hodor."
        },
        "hodor.ai.mode": {
          "type": "string",
          "enum": ["plan", "ask", "auto", "full"],
          "enumDescriptions": [
            "Plan: reads the code and writes a plan; changes nothing until you approve.",
            "Ask before edits: every change waits for Apply, every command for Run.",
            "Edit automatically: changes apply right away; commands still ask.",
            "Full access: changes and commands run without asking."
          ],
          "default": "ask",
          "description": "What the chat may do without asking (also in the chat's input box)."
        },
        "hodor.ai.model": {
          "type": "string",
          "default": "",
          "description": "The AI model the chat uses (pick it in the chat's input box)."
        },
        "hodor.ai.provider": {
          "type": "string",
          "enum": ["claude", "gemini"],
          "enumDescriptions": ["Claude (Anthropic)", "Google Gemini"],
          "default": "claude",
          "description": "The AI the chat uses, when you have keys for both (add them on Hodor's MCP / CLI page)."
        },
        "hodor.ai.autoApply": {
          "type": "boolean",
          "default": false,
          "description": "Apply the chat's code changes right away instead of showing them for review first. Applied changes can be undone with Undo or git.",
          "deprecationMessage": "Use the chat's mode instead (hodor.ai.mode: Edit automatically)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "npm run build && tsc -p test/integration && node out/test/integration/runTest.js",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^10.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ignore": "^7.0.14"
  }
}
